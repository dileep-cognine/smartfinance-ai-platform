# Database
POSTGRES_USER=smartfinance
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smartfinance_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://smartfinance:change_me@postgres:5432/mlflow_db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# LLM and model providers (leave blank to use local deterministic fallbacks)
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Data providers
ALPHA_VANTAGE_API_KEY=
REDIS_URL=redis://redis:6379/0

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://smartfinance:change_me@postgres:5432/airflow_db
AIRFLOW__WEBSERVER__SECRET_KEY=replace_with_a_long_random_value
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_UID=50000
AIRFLOW_API_URL=http://airflow-webserver:8080

# Application
LOG_LEVEL=INFO
DATA_DIR=/app/data
ARTIFACT_DIR=/app/artifacts
RAG_TOP_K=5
RAG_MEMORY_TURNS=5
RAG_API_URL=http://rag_api:8000/query
TOOL_CACHE_TTL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=30
MAX_PROMPT_LENGTH=4000
WEB_SEARCH_ENDPOINT=

# Jupyter
JUPYTER_TOKEN=smartfinance
